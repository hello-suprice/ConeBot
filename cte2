#include <iostream>
#include <opencv2/opencv.hpp>

using namespace std;
using namespace cv;

// Vår uppdaterade hjälpfunktion med PROPORTIONSFILTRERING
Rect getLargestBoundingBox(const vector<vector<Point>>& contours) {
    double maxArea = 0;
    Rect largestBbox;
    
    for (const auto& contour : contours) {
        double area = contourArea(contour);
        
        // 1. Filtrera bort bakgrundsbrus (måste vara större än 500 pixlar)
        if (area > 500) {
            Rect bbox = boundingRect(contour);
            
            // 2. Räkna ut rektangelns proportioner (Höjd delat på Bredd)
            double aspectRatio = (double)bbox.height / bbox.width;
            
            // 3. VILLKOR FÖR ATT VARA EN KON:
            // - Måste vara högre än den är bred (aspectRatio > 1.1)
            // - Får inte vara onormalt bred i bilden (t.ex. max 200 pixlar)
            // - Får inte vara ett smalt streck (aspectRatio < 3.0)
            if (aspectRatio > 1.1 && aspectRatio < 3.0 && bbox.width < 200) {
                
                // Om formen är godkänd, kolla om den är störst hittills
                if (area > maxArea) {
                    maxArea = area;
                    largestBbox = bbox;
                }
            }
        }
    }
    return largestBbox;
}

int main() {
    // Starta kameran med full obeskuren upplösning (640x360)
    string pipeline = "libcamerasrc ! video/x-raw, width=640, height=360, framerate=30/1 ! videoconvert ! appsink drop=true";
    VideoCapture cap(pipeline, cv::CAP_GSTREAMER);
    
    if (!cap.isOpened()) {
        cerr << "Kunde inte hitta kameran!" << endl;
        return -1;
    }

    cout << "Kameran startad med överlappningsskydd. Tryck 'q' för att avsluta." << endl;

    Mat frame, hsv, mask_yellow, mask_blue;
    const int CAMERA_CENTER_X = 320; 

    while (true) {
        cap >> frame;
        if (frame.empty()) break;

        flip(frame, frame, -1); 

        cvtColor(frame, hsv, COLOR_BGR2HSV);

        // Färggränser för GUL och BLÅ
        Scalar lower_yellow(20, 100, 100);
        Scalar upper_yellow(35, 255, 255);
        Scalar lower_blue(100, 150, 50);
        Scalar upper_blue(130, 255, 255);

        inRange(hsv, lower_yellow, upper_yellow, mask_yellow);
        inRange(hsv, lower_blue, upper_blue, mask_blue);

        vector<vector<Point>> contours_yellow, contours_blue;
        findContours(mask_yellow, contours_yellow, RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);
        findContours(mask_blue, contours_blue, RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);

        // Hitta de största konerna som OCKSÅ har rätt form!
        Rect bbox_yellow = getLargestBoundingBox(contours_yellow);
        Rect bbox_blue = getLargestBoundingBox(contours_blue);

        // Om vi hittade en godkänd gul OCH blå kon, rita linjerna!
        if (bbox_yellow.area() > 0 && bbox_blue.area() > 0) {
            
            rectangle(frame, bbox_yellow, Scalar(0, 255, 255), 2);
            rectangle(frame, bbox_blue, Scalar(255, 0, 0), 2);

            Point center_yellow(bbox_yellow.x + bbox_yellow.width / 2, bbox_yellow.y + bbox_yellow.height / 2);
            Point center_blue(bbox_blue.x + bbox_blue.width / 2, bbox_blue.y + bbox_blue.height / 2);

            line(frame, center_yellow, center_blue, Scalar(0, 255, 0), 2);

            Point midpoint((center_yellow.x + center_blue.x) / 2, (center_yellow.y + center_blue.y) / 2);
            circle(frame, midpoint, 6, Scalar(0, 0, 255), -1);

            int cte = midpoint.x - CAMERA_CENTER_X;
            Point camera_bottom_center(CAMERA_CENTER_X, 360);
            line(frame, camera_bottom_center, midpoint, Scalar(0, 0, 255), 2);

            string cte_text = "CTE: " + to_string(cte) + " px";
            putText(frame, cte_text, Point(10, 30), FONT_HERSHEY_SIMPLEX, 0.8, Scalar(0, 0, 255), 2);
        }

        imshow("ConeBot Anti-Overlap Test", frame);

        if (waitKey(30) == 'q') break;
    }

    cap.release();
    destroyAllWindows();
    return 0;
}
