#include <iostream>
#include <opencv2/opencv.hpp>
#include <pigpio.h>      // Bibliotek för att styra GPIO-stift
#include <chrono>        // Bibliotek för att mäta tid till PI-regulatorn

using namespace std;
using namespace cv;

// --- GPIO-STIFT (Baserat på Robocar-standarden) ---
const int MOTOR_PWM = 18;  // PWM till H-bryggan (Hastighet)
const int MOTOR_IN1 = 14;  // Riktning framåt
const int MOTOR_IN2 = 15;  // Riktning bakåt
const int SERVO_PWM = 13;  // PWM till Styrservot

// Hjälpfunktion för att hitta den STÖRSTA konen (utan avancerad överlappnings-koll just nu)
Rect getLargestBoundingBox(const vector<vector<Point>>& contours) {
    double maxArea = 0;
    Rect largestBbox;
    for (const auto& contour : contours) {
        double area = contourArea(contour);
        if (area > 500 && area > maxArea) {
            maxArea = area;
            largestBbox = boundingRect(contour);
        }
    }
    return largestBbox;
}

int main() {
    // 1. STARTA GPIO OCH MOTORER
    if (gpioInitialise() < 0) {
        cerr << "Kunde inte starta pigpio! Kör du med sudo?" << endl;
        return -1;
    }

    gpioSetMode(MOTOR_PWM, PI_OUTPUT);
    gpioSetMode(MOTOR_IN1, PI_OUTPUT);
    gpioSetMode(MOTOR_IN2, PI_OUTPUT);
    gpioSetMode(SERVO_PWM, PI_OUTPUT);

    // Sätt motorn till att rulla framåt
    gpioWrite(MOTOR_IN1, 1);
    gpioWrite(MOTOR_IN2, 0);

    // 2. STARTA KAMERAN
    string pipeline = "libcamerasrc ! video/x-raw, width=640, height=360, framerate=30/1 ! videoconvert ! appsink drop=true";
    VideoCapture cap(pipeline, cv::CAP_GSTREAMER);
    
    if (!cap.isOpened()) {
        cerr << "Kunde inte hitta kameran!" << endl;
        return -1;
    }

    cout << "Startar autonom körning... Tryck 'q' för att stanna." << endl;

    Mat frame, hsv, mask_yellow, mask_blue;
    const int CAMERA_CENTER_X = 320; 

    // --- PI-REGULATORNS VARIABLER ---
    double Kp = 0.8;  // Proportionell (Justera detta värde sen!)
    double Ki = 0.0;  // Integrerande (Vi börjar på 0 för enkelhetens skull)
    double integral = 0;
    
    // Standard servomitten är ofta 1500 mikrosekunder
    int base_servo_pwm = 1500; 
    int prev_servo_pwm = base_servo_pwm; 
    int motor_speed = 100; // Grundhastighet (0-255)

    auto prevTime = chrono::high_resolution_clock::now();

    while (true) {
        cap >> frame;
        if (frame.empty()) break;

        flip(frame, frame, -1); 
        cvtColor(frame, hsv, COLOR_BGR2HSV);

        // Färggränser
        Scalar lower_yellow(20, 100, 100);
        Scalar upper_yellow(35, 255, 255);
        Scalar lower_blue(100, 150, 50);
        Scalar upper_blue(130, 255, 255);

        inRange(hsv, lower_yellow, upper_yellow, mask_yellow);
        inRange(hsv, lower_blue, upper_blue, mask_blue);

        vector<vector<Point>> contours_yellow, contours_blue;
        findContours(mask_yellow, contours_yellow, RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);
        findContours(mask_blue, contours_blue, RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);

        Rect bbox_yellow = getLargestBoundingBox(contours_yellow);
        Rect bbox_blue = getLargestBoundingBox(contours_blue);

        // FLÖDESSCHEMA: Ser vi koner?
        if (bbox_yellow.area() > 0 && bbox_blue.area() > 0) {
            
            // Räkna ut Look-ahead och CTE
            Point center_yellow(bbox_yellow.x + bbox_yellow.width / 2, bbox_yellow.y + bbox_yellow.height / 2);
            Point center_blue(bbox_blue.x + bbox_blue.width / 2, bbox_blue.y + bbox_blue.height / 2);
            Point midpoint((center_yellow.x + center_blue.x) / 2, (center_yellow.y + center_blue.y) / 2);
            
            double cte = midpoint.x - CAMERA_CENTER_X;

            // --- PI REGULERING ---
            auto now = chrono::high_resolution_clock::now();
            chrono::duration<double> elapsed = now - prevTime;
            double dt = elapsed.count();
            prevTime = now;

            integral += cte * dt;
            double output = (Kp * cte) + (Ki * integral);

            // --- STYRSIGNAL TILL SERVO ---
            // Vi drar bort output från mittenläget. (Beroende på hur ditt servo sitter monterat 
            // kanske vi behöver byta till plus istället för minus här).
            int current_servo_pwm = base_servo_pwm - static_cast<int>(output);

            // Begränsa så vi inte spränger servot (mekaniskt max/min)
            current_servo_pwm = max(1000, min(2000, current_servo_pwm)); [6]

            // Skicka styrsignalen till servot och starta DC-motorn
            gpioServo(SERVO_PWM, current_servo_pwm);
            gpioPWM(MOTOR_PWM, motor_speed); 

            // Spara värdet till nästa loop
            prev_servo_pwm = current_servo_pwm;

            // Rita visuellt för skärmen
            circle(frame, midpoint, 6, Scalar(0, 0, 255), -1);
            putText(frame, "CTE: " + to_string((int)cte), Point(10, 30), FONT_HERSHEY_SIMPLEX, 0.8, Scalar(0, 0, 255), 2);
        } 
        else {
            // FLÖDESSCHEMA: Nej, vi ser inga koner -> Behåll föregående värden
            gpioServo(SERVO_PWM, prev_servo_pwm);
            gpioPWM(MOTOR_PWM, motor_speed);
            putText(frame, "INGA KONER - HALLER KURSEN", Point(10, 30), FONT_HERSHEY_SIMPLEX, 0.8, Scalar(0, 255, 255), 2);
        }

        imshow("ConeBot Drive Test", frame);

        // Avbryt och STANNA BILEN med 'q'
        if (waitKey(30) == 'q') {
            gpioPWM(MOTOR_PWM, 0); // Nödstopp motor
            gpioServo(SERVO_PWM, 1500); // Centrera hjulen
            break;
        }
    }

    // Stäng ner allt snyggt när programmet avslutas
    cap.release();
    destroyAllWindows();
    gpioPWM(MOTOR_PWM, 0);
    gpioTerminate();
    return 0;
}
