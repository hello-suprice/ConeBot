/*
 * ConeBot main program
 * MF133X KTH
 *
 * Purpose:
 * Detects blue and yellow cones in the camera image, calculates Cross-Track Error (CTE)
 * and controls the vehicle using a PI controller.
 *
 * Main parts:
 * 1. Initialization of GPIO, camera and video recording
 * 2. Color filtering in HSV and cone detection
 * 3. Matching cone pairs and calculating the target point
 * 4. PI control and steering signal to the servo
 * 5. FPS limiting, logging and safe shutdown
 */
// Libraries:
#include <opencv2/opencv.hpp>
#include <pigpio.h>
#include <chrono>                // time measurement between frames
#include <iostream>              // print text to terminal
#include <csignal>               // signal handling such as Ctrl+C
#include <ctime>                 // date and time for unique video filename

// Avoid long prefixes:
using namespace std;
using namespace cv;


#define MOTOR_PWM  18
#define MOTOR_HIGH 14
#define MOTOR_LOW  15
#define SERVO_PWM  13

volatile sig_atomic_t keepRunning = 1;       // global run flag

// Handle safe shutdown on Ctrl+C, prevents abrupt exit
void stopProgram(int signum) {
    cout << "\n[Ctrl+C] Exiting..." << endl;
    keepRunning = 0;
}
// Shut down motor, servo and GPIO safely so the car does not remain
// with an active motor signal if the program ends
void safeShutdown() {
    gpioWrite(MOTOR_HIGH, 0);
    gpioWrite(MOTOR_LOW,  0);
    gpioPWM(MOTOR_PWM, 0);
    gpioServo(SERVO_PWM, 2150);
    gpioDelay(300000);
    gpioTerminate();
}

int main() {
    // Configure pigpio so the program handles Ctrl+C itself.
    // Important because we want to safely stop motors and servos
    // before the program exits.
    int cfg = gpioCfgGetInternals();
    cfg |= PI_CFG_NOSIGHANDLER;
    gpioCfgSetInternals(cfg);
    signal(SIGINT, stopProgram);

    if (gpioInitialise() < 0) {
        cerr << "Failed to start pigpio." << endl;
        return -1;
    }
    // Configure GPIO for motor and servo as outputs
    gpioSetMode(MOTOR_HIGH, PI_OUTPUT);
    gpioSetMode(MOTOR_LOW,  PI_OUTPUT);
    gpioSetMode(MOTOR_PWM,  PI_OUTPUT);
    gpioSetMode(SERVO_PWM,  PI_OUTPUT);

    gpioWrite(MOTOR_HIGH, 0);                     // Before driving, set all control signals
    gpioWrite(MOTOR_LOW,  0);                     // to a safe initial state. Prevents the car
    gpioPWM(MOTOR_PWM, 0);                        // from jerking forward when the program starts.
    gpioServo(SERVO_PWM, 2150);


    // ─────────────────────────────────────────────────────────────
    // PARAMETERS
    // ─────────────────────────────────────────────────────────────
    int    motorSpeed    = 85;
    double Kp            = 0.6;
    double Ki            = 0.005;
    int    startDelaySec = 3;
    double smoothing     = 0.35;
    int    minArea       = 50;
    double maxAreaRatio  = 2.5;
    double targetFPS     = 15.0;          // <-- change to 10.0 or 5.0 for next tests
    double targetFrameTime = 1.0 / targetFPS;
    // ─────────────────────────────────────────────────────────────
    
    
    // Start camera via GStreamer
    string pipeline = "libcamerasrc ! video/x-raw,width=640,height=480,framerate=30/1 ! videoconvert ! video/x-raw,format=BGR ! appsink drop=true sync=false";
    VideoCapture cap(pipeline, CAP_GSTREAMER);

    if (!cap.isOpened()) {
        cerr << "Could not open camera!" << endl;
        safeShutdown();
        return -1;
    }
    // Create video file for logging the test run
    time_t now_t = time(nullptr);
    char timestr[64];
    strftime(timestr, sizeof(timestr), "%Y%m%d_%H%M%S", localtime(&now_t));
    string videoFile = "/home/hmm/conebot_run_" + string(timestr) + ".avi";

    VideoWriter writer;
    writer.open(videoFile,
                VideoWriter::fourcc('M','J','P','G'),
                targetFPS,
                Size(640, 480));

    if (!writer.isOpened()) {
        cerr << "Could not create video file: " << videoFile << endl;
        cap.release();
        safeShutdown();
        return -1;
    }
    
    cout << "=== CONEBOT V5 ===" << endl;
    cout << "Recording to: " << videoFile << endl;
    cout << "Kp=" << Kp << " Ki=" << Ki
         << " Smoothing=" << smoothing
         << " Speed=" << motorSpeed
         << " FPS=" << targetFPS << endl;
    cout << "Starting in " << startDelaySec << " seconds..." << endl;
    
    // Initialize variables for steering, timing and logging
    Mat frame, hsv, maskBlue, maskYellow;
    int    currentSteering  = 2150;
    double smoothedSteering = 2150.0;
    double integral         = 0.0;
    auto   prevTime         = chrono::high_resolution_clock::now();
    auto   startTime        = chrono::high_resolution_clock::now();
    bool   motorStarted     = false;
    int    frameCount       = 0;

    while (keepRunning) {
        // Read next frame and start FPS timing
        // FPS limiting: start timing for this frame
        auto fpsStart = chrono::high_resolution_clock::now();

        cap >> frame;
        if (frame.empty()) continue;

        flip(frame, frame, -1);
        frameCount++;
        
        // Convert image to HSV and create color masks
        cvtColor(frame, hsv, COLOR_BGR2HSV);

        inRange(hsv, Scalar(109, 129, 23),  Scalar(130, 255, 255), maskBlue);
        inRange(hsv, Scalar(17,  175, 142), Scalar(34,  255, 255), maskYellow);
       
        // Find contours for blue and yellow cones
        vector<vector<Point>> contoursBlue, contoursYellow;
        findContours(maskBlue,   contoursBlue,   RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);
        findContours(maskYellow, contoursYellow, RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);

        // Find largest yellow (reference)
        double maxAreaYellow = 0;
        Rect   bestYellow;
        for (const auto& c : contoursYellow) {
            double a = contourArea(c);
            if (a > maxAreaYellow) {
                maxAreaYellow = a;
                bestYellow    = boundingRect(c);
            }
        }

        // Find blue cone that best matches yellow in area
        double maxAreaBlue  = 0;
        double bestBlueDiff = 1e9;
        Rect   bestBlue;
        for (const auto& c : contoursBlue) {
            double a = contourArea(c);
            if (a < minArea) continue;
            if (maxAreaYellow > 0) {
                double diff = abs(a - maxAreaYellow);
                if (diff < bestBlueDiff) {
                    bestBlueDiff = diff;
                    maxAreaBlue  = a;
                    bestBlue     = boundingRect(c);
                }
            } else {
                if (a > maxAreaBlue) {
                    maxAreaBlue = a;
                    bestBlue    = boundingRect(c);
                }
            }
        }

        // Visualization
        Mat display = frame.clone();
        line(display, Point(320, 0), Point(320, 480), Scalar(255,255,255), 1);

        // All contours as thin boxes
        for (const auto& c : contoursBlue)
            if (contourArea(c) > 30)
                rectangle(display, boundingRect(c), Scalar(150,80,0), 1);
        for (const auto& c : contoursYellow)
            if (contourArea(c) > 30)
                rectangle(display, boundingRect(c), Scalar(0,100,150), 1);

        // Best cones in thick lines
        if (maxAreaBlue > minArea) {
            rectangle(display, bestBlue, Scalar(255,0,0), 3);
            circle(display,
                   Point(bestBlue.x + bestBlue.width/2,
                         bestBlue.y + bestBlue.height/2),
                   6, Scalar(255,0,0), -1);
            putText(display, "BLUE " + to_string((int)maxAreaBlue),
                    Point(bestBlue.x, max(bestBlue.y-8, 15)),
                    FONT_HERSHEY_SIMPLEX, 0.5, Scalar(255,0,0), 2);
        }
        if (maxAreaYellow > minArea) {
            rectangle(display, bestYellow, Scalar(0,200,255), 3);
            circle(display,
                   Point(bestYellow.x + bestYellow.width/2,
                         bestYellow.y + bestYellow.height/2),
                   6, Scalar(0,200,255), -1);
            putText(display, "YELLOW " + to_string((int)maxAreaYellow),
                    Point(bestYellow.x, max(bestYellow.y-8, 15)),
                    FONT_HERSHEY_SIMPLEX, 0.5, Scalar(0,200,255), 2);
        }

        if (maxAreaBlue > minArea && maxAreaYellow > minArea) {

            double areaRatio = maxAreaBlue / maxAreaYellow;

            if (areaRatio > maxAreaRatio || areaRatio < (1.0 / maxAreaRatio)) {
                // Wrong pair
                integral = 0.0;
                prevTime = chrono::high_resolution_clock::now();
                smoothedSteering = smoothing * smoothedSteering
                                 + (1.0 - smoothing) * 2150.0;

                putText(display, "WRONG PAIR ratio:" +
                        to_string(areaRatio).substr(0,4),
                        Point(10,30), FONT_HERSHEY_SIMPLEX,
                        0.7, Scalar(0,100,255), 2);

                cout << "WRONG PAIR ratio=" << areaRatio
                     << " Blue:" << (int)maxAreaBlue
                     << " Yellow:" << (int)maxAreaYellow << endl;

            } else {
                // Correct pair
                double blueCX     = bestBlue.x   + bestBlue.width   / 2.0;
                double yellowCX   = bestYellow.x + bestYellow.width / 2.0;
                double lookAheadX = (blueCX + yellowCX) / 2.0;
                double blueCY     = bestBlue.y   + bestBlue.height  / 2.0;
                double yellowCY   = bestYellow.y + bestYellow.height / 2.0;
                double lookAheadY = (blueCY + yellowCY) / 2.0;

                double cte = 320.0 - lookAheadX;

                auto now2 = chrono::high_resolution_clock::now();
                double dt = chrono::duration<double>(now2 - prevTime).count();
                prevTime = now2;

                integral += cte * dt;
                double output = (Kp * cte) + (Ki * integral);

                currentSteering = 2150 - static_cast<int>(output);
                currentSteering = max(1900, min(2400, currentSteering));

                smoothedSteering = smoothing * smoothedSteering
                                 + (1.0 - smoothing) * currentSteering;

                line(display,
                     Point((int)blueCX,  (int)blueCY),
                     Point((int)yellowCX,(int)yellowCY),
                     Scalar(0,255,0), 2);
                circle(display,
                       Point((int)lookAheadX,(int)lookAheadY),
                       10, Scalar(0,255,0), -1);
                line(display, Point(320,480),
                     Point((int)lookAheadX,(int)lookAheadY),
                     Scalar(0,255,0), 2);

                putText(display, "CTE: " + to_string((int)cte),
                        Point(10,30), FONT_HERSHEY_SIMPLEX, 0.7, Scalar(0,255,0), 2);
                putText(display, "PWM: " + to_string((int)smoothedSteering),
                        Point(10,60), FONT_HERSHEY_SIMPLEX, 0.7, Scalar(0,255,0), 2);
                putText(display, "Ratio: " + to_string(areaRatio).substr(0,4),
                        Point(10,90), FONT_HERSHEY_SIMPLEX, 0.6, Scalar(200,255,0), 1);

                cout << "CTE: " << (int)cte
                     << " | PWM: " << (int)smoothedSteering
                     << " | Ratio: " << to_string(areaRatio).substr(0,4) << endl;
            }

        } else {
            integral = 0.0;
            prevTime = chrono::high_resolution_clock::now();
            smoothedSteering = smoothing * smoothedSteering
                             + (1.0 - smoothing) * 2150.0;

            string missing = "";
            if (maxAreaBlue   <= minArea) missing += "MISSING BLUE  ";
            if (maxAreaYellow <= minArea) missing += "MISSING YELLOW";
            putText(display, missing,
                    Point(10,30), FONT_HERSHEY_SIMPLEX, 0.8, Scalar(0,0,255), 2);
            putText(display, "Blue:" + to_string((int)maxAreaBlue) +
                             " Yellow:" + to_string((int)maxAreaYellow),
                    Point(10,60), FONT_HERSHEY_SIMPLEX, 0.6, Scalar(0,100,255), 2);

            cout << missing
                 << " Blue:" << (int)maxAreaBlue
                 << " Yellow:" << (int)maxAreaYellow << endl;
        }

        // Steering indicator
        int barCX = 320, barY = 455, barHW = 180;
        rectangle(display, Point(barCX-barHW, barY-7),
                            Point(barCX+barHW, barY+7), Scalar(50,50,50), -1);
        line(display, Point(barCX, barY-11),
             Point(barCX, barY+11), Scalar(255,255,255), 1);
        int barOff = (int)(((smoothedSteering-2150)/250.0)*barHW);
        rectangle(display, Point(barCX, barY-5),
                            Point(barCX+barOff, barY+5),
                            barOff > 0 ? Scalar(0,150,255) : Scalar(255,150,0), -1);

        // FPS display on screen
        putText(display, "FPS: " + to_string((int)targetFPS),
                Point(10, 150), FONT_HERSHEY_SIMPLEX, 0.6, Scalar(200,200,0), 1);

        // Motor start
        double elapsed = chrono::duration<double>(
            chrono::high_resolution_clock::now() - startTime).count();

        if (!motorStarted && elapsed >= startDelaySec) {
            cout << ">>> MOTOR STARTING <<<" << endl;
            gpioWrite(MOTOR_HIGH, 1);
            gpioWrite(MOTOR_LOW,  0);
            gpioPWM(MOTOR_PWM, motorSpeed);
            motorStarted = true;
        }

        if (!motorStarted) {
            putText(display,
                    "Start in: " + to_string(startDelaySec-(int)elapsed) + "s",
                    Point(10,120), FONT_HERSHEY_SIMPLEX, 0.8, Scalar(0,255,255), 2);
        } else {
            putText(display, "MOTOR ON",
                    Point(10,120), FONT_HERSHEY_SIMPLEX, 0.6, Scalar(0,255,0), 1);
        }

        gpioServo(SERVO_PWM, (int)smoothedSteering);

        if (writer.isOpened()) {
            writer.write(display);
        }

        // ─── FPS LIMITING ─────────────────────────────────────────
        auto fpsEnd = chrono::high_resolution_clock::now();
        double frameElapsed = chrono::duration<double>(fpsEnd - fpsStart).count();
        if (frameElapsed < targetFrameTime) {
            gpioDelay((unsigned)((targetFrameTime - frameElapsed) * 1000000));
        }
        // ───────────────────────────────────────────────────────────
    }

    safeShutdown();
    cap.release();
    if (writer.isOpened()) {
        writer.release();
    }
    cout << "Video saved: " << videoFile << endl;
    cout << "Frames recorded: " << frameCount << endl;
    return 0;
}
