#include <iostream>
#include <pigpio.h>
#include <unistd.h>

using namespace std;

#define MOTOR_PWM 18
#define MOTOR_HIGH 14 // Riktning framåt
#define MOTOR_LOW 15  // Riktning bakåt

int main() {
    if (gpioInitialise() < 0) {
        cerr << "Kunde inte starta pigpio." << endl;
        return -1;
    }

    // Aktivera pinnarna
    gpioSetMode(MOTOR_PWM, PI_OUTPUT);
    gpioSetMode(MOTOR_HIGH, PI_OUTPUT);
    gpioSetMode(MOTOR_LOW, PI_OUTPUT);

    // Sätt riktningen till FRAMÅT (HIGH = på, LOW = av)
    gpioWrite(MOTOR_HIGH, 1);
    gpioWrite(MOTOR_LOW, 0);

    cout << "Startar motorn på halv fart framåt..." << endl;
    gpioPWM(MOTOR_PWM, 128); 

    sleep(2); 

    cout << "Stannar motorn." << endl;
    gpioPWM(MOTOR_PWM, 0);
    
    // Stäng av riktningssignalerna
    gpioWrite(MOTOR_HIGH, 0);

    gpioTerminate();
    return 0;
}
