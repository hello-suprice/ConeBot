#include <iostream>
#include <pigpio.h>
#include <unistd.h> // Används för att pausa koden (sleep)

using namespace std;

#define MOTOR_PWM 18 // Den GPIO-pinne vi kopplat H-bryggan till

int main() {
    // 1. Starta kopplingen till GPIO-pinnarna
    if (gpioInitialise() < 0) {
        cerr << "Kunde inte starta pigpio. Körde du med sudo?" << endl;
        return -1;
    }

    // 2. Berätta för datorn att pinne 18 ska skicka ut signal
    gpioSetMode(MOTOR_PWM, PI_OUTPUT);

    // 3. Starta motorn! (128 är halv hastighet, 255 är max)
    cout << "Startar motorn på halv fart..." << endl;
    gpioPWM(MOTOR_PWM, 128); 

    // 4. Låt den snurra i 2 sekunder
    sleep(2); 

    // 5. Stanna motorn
    cout << "Stannar motorn." << endl;
    gpioPWM(MOTOR_PWM, 0);

    // Stäng av pigpio säkert
    gpioTerminate();
    
    return 0;
}
